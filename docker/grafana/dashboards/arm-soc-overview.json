          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT principal AS Account, priority_score AS PriorityScore, priority_reason AS WhyFirst, incident_count AS Incidents, risky_event_count AS RiskSignals, failure_event_count AS Failures, max_score AS MaxScore, last_seen_at AS LastSeen FROM vw_grafana_m365_account_risk WHERE priority_score > 0 ORDER BY priority_score DESC, incident_count DESC, max_score DESC LIMIT 8;",
